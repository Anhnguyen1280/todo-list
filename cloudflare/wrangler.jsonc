{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "todo-list",
	"main": "./src/worker.js",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "todo-list-db",
			"database_id": "22f1a47c-2f86-4adb-ad01-96b9cae9242a"
		}
	]
}